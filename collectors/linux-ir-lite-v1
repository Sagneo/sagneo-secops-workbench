#!/usr/bin/python3
"""Root-owned forced command for the fixed linux-ir-lite-v1 profile."""

import base64
import hashlib
import json
import os
import stat
# Only the fixed COMMANDS tuples are executed.
import subprocess  # nosec B404
import sys
import threading
import time

COMMANDS = (
    ("utc_time", (("/usr/bin/date", "--utc", "--iso-8601=seconds"),)),
    ("system", (("/usr/bin/hostnamectl", "--static"), ("/usr/bin/hostnamectl",))),
    ("processes", (("/usr/bin/ps", "-eo", "pid,user,comm,args", "--no-headers"),)),
    ("network", (("/usr/sbin/ip", "-br", "addr"), ("/usr/bin/ss", "-lntup"))),
    (
        "failed_services",
        (("/usr/bin/systemctl", "--failed", "--no-pager", "--plain"),),
    ),
    ("logins", (("/usr/bin/last", "-n", "50", "-F", "-w"),)),
    (
        "ssh_sudo_journal",
        (
            (
                "/usr/bin/journalctl",
                "--no-pager",
                "--output=short-iso",
                "--lines=200",
                "_COMM=sshd",
            ),
            (
                "/usr/bin/journalctl",
                "--no-pager",
                "--output=short-iso",
                "--lines=200",
                "_COMM=sudo",
            ),
        ),
    ),
)
CONFIG_PATHS = (
    "/etc/ssh/sshd_config",
    "/etc/ssh/sshd_config.d/99-sagneo-key-only.conf",
)
MAX_BYTES = 1_048_576
MAX_TOTAL = 5_242_880
MAX_STDERR = 65_536


class ProcessBoundError(RuntimeError):
    pass


def read_pipe(pipe, limit, chunks, overflow):
    total = 0
    try:
        while True:
            chunk = pipe.read(min(65_536, limit - total + 1))
            if not chunk:
                return
            chunks.append(chunk)
            total += len(chunk)
            if total > limit:
                overflow.set()
                return
    finally:
        pipe.close()


def run_bounded_command(command, stdout_limit, timeout=5):
    if stdout_limit < 0:
        raise ProcessBoundError
    # The argv is fixed and shell execution is never used.
    process = subprocess.Popen(  # nosec B603
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    stdout_chunks = []
    stderr_chunks = []
    stdout_overflow = threading.Event()
    stderr_overflow = threading.Event()
    readers = (
        threading.Thread(
            target=read_pipe,
            args=(process.stdout, stdout_limit, stdout_chunks, stdout_overflow),
            daemon=True,
        ),
        threading.Thread(
            target=read_pipe,
            args=(process.stderr, MAX_STDERR, stderr_chunks, stderr_overflow),
            daemon=True,
        ),
    )
    for reader in readers:
        reader.start()
    deadline = time.monotonic() + timeout
    failed = False
    while process.poll() is None:
        if (
            stdout_overflow.is_set()
            or stderr_overflow.is_set()
            or time.monotonic() >= deadline
        ):
            failed = True
            process.kill()
            break
        time.sleep(0.01)
    process.wait()
    for reader in readers:
        reader.join(timeout=1)
    if (
        failed
        or stdout_overflow.is_set()
        or stderr_overflow.is_set()
        or any(reader.is_alive() for reader in readers)
    ):
        process.kill()
        process.wait()
        raise ProcessBoundError
    stdout = b"".join(stdout_chunks)
    stderr = b"".join(stderr_chunks)
    if process.returncode != 0 or stderr:
        raise RuntimeError
    return stdout


def command_artifact(commands, total_remaining):
    output = bytearray()
    for command in commands:
        remaining = min(MAX_BYTES - len(output), total_remaining - len(output))
        output.extend(
            run_bounded_command(
                command,
                remaining,
                timeout=5,
            )
        )
    return bytes(output)


def hash_file_bounded(raw_path):
    digest = hashlib.sha256()
    total = 0
    with open(raw_path, "rb") as handle:
        while True:
            chunk = handle.read(min(65_536, MAX_BYTES - total + 1))
            if not chunk:
                return total, digest.hexdigest()
            total += len(chunk)
            if total > MAX_BYTES:
                raise ProcessBoundError
            digest.update(chunk)


def config_metadata(total_remaining):
    lines = []
    for raw_path in CONFIG_PATHS:
        try:
            info = os.stat(raw_path, follow_symlinks=False)
            if not stat.S_ISREG(info.st_mode):
                raise RuntimeError
            size, digest = hash_file_bounded(raw_path)
            if size != info.st_size:
                raise RuntimeError
            lines.append(
                f"{raw_path} mode={stat.S_IMODE(info.st_mode):04o} "
                f"size={info.st_size} sha256={digest}"
            )
        except FileNotFoundError:
            lines.append(f"{raw_path} absent")
    result = ("\n".join(lines) + "\n").encode()
    if not result or len(result) > min(MAX_BYTES, total_remaining):
        raise ProcessBoundError
    return result


def main():
    if len(sys.argv) != 1:
        return 64
    total = 0
    artifacts = []
    try:
        for name, commands in COMMANDS:
            content = command_artifact(commands, MAX_TOTAL - total)
            if not content:
                return 66
            total += len(content)
            artifacts.append((name, content))
        content = config_metadata(MAX_TOTAL - total)
        total += len(content)
        artifacts.append(("ssh_config_metadata", content))
    except (ProcessBoundError, RuntimeError, subprocess.SubprocessError):
        return 66
    for name, content in artifacts:
        print(
            json.dumps(
                {"name": name, "content_b64": base64.b64encode(content).decode("ascii")},
                sort_keys=True,
                separators=(",", ":"),
            ),
            flush=True,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
